# Variáveis de ambiente — copiar para .env.local e ajustar os valores
# Este arquivo contém apenas valores fictícios e seguros para documentação.

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:exemplo-senha-local@localhost:5432/ligcentro
# Em produção com o pooler Supabase, use DATABASE_SSL=true.
# DATABASE_SSL=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://exemplo-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=exemplo-segredo-nextauth-ficticio

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Analytics (interno) ──────────────────────────────────────────────────────
# Analytics próprio, armazenado na tabela Postgres.
# ANALYTICS_RETENTION_DAYS=730
