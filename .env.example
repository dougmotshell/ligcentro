NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJfZXhlbXBsZV9hbm9uX2tleV9maWN0aWNpYQ
SUPABASE_SERVICE_ROLE_KEY=eyJfZXhlbXBsZV9zZXJ2aWNlX3JvbGVfa2V5X2ZpY3RpY2lh

